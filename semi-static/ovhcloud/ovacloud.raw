<thead>
  <tr>
    <th data-extension-name="" class="text-nowrap"><button class="ods-tld-filter__button font-weight-bold"
        data-sort="data-extension-name">
        Rozszerzenie
        <span class="icon icon--sort"></span>
      </button>

    </th>
    <th data-installation-price="" class="text-nowrap text-right"><button
        class="ods-tld-filter__button font-weight-bold" data-sort="data-installation-price">
        Rejestracja
        <span class="ods-tld-filter__button__year-price text-level--sm">(cena/rok)</span>
        <span class="icon icon--sort"></span>
      </button>

    </th>
    <th data-renew-price="" class="text-nowrap text-right"><button class="ods-tld-filter__button font-weight-bold"
        data-sort="data-renew-price">
        Renew
        <span class="ods-tld-filter__button__year-price text-level--sm">(cena/rok)</span>
        <span class="icon icon--sort"></span>
      </button>

    </th>
    <th data-transfer-price="" class="d-none text-nowrap text-right"><button
        class="ods-tld-filter__button font-weight-bold" data-sort="data-transfer-price">
        Transfer
        <span class="ods-tld-filter__button__year-price text-level--sm">(cena/rok)</span>
        <span class="icon icon--sort"></span>
      </button>

    </th>
    <th #theme="tld_price_header_cell"></th>
  </tr>
</thead>

